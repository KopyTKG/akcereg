generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model historie_terminu {
  id            String    @id @db.Uuid
  student_id    String    @db.Char(40)
  termin_id     String    @db.Uuid
  datum_splneni DateTime? @db.Timestamp(6)
  student       student   @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  termin        termin    @relation(fields: [termin_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model predmet {
  kod_predmetu       String               @id
  zkratka_predmetu   String?
  katedra            String?
  pocet_cviceni      Int?
  termin             termin[]
  vyucujici_predmety vyucujici_predmety[]
}

model student {
  id               String             @id @db.Char(40)
  datum_vytvoreni  DateTime           @db.Timestamp(6)
  historie_terminu historie_terminu[]
}

model termin {
  id                                     String             @id @db.Uuid
  ucebna                                 String?
  datum_start                            DateTime?          @db.Timestamp(6)
  aktualni_kapacita                      Int?
  max_kapacita                           Int?
  vypsal_id                              String             @db.Char(40)
  vyucuje_id                             String             @db.Char(40)
  kod_predmet                            String
  jmeno                                  String?
  cislo_cviceni                          Int?
  datum_konec                            DateTime?          @db.Timestamp(6)
  popis                                  String?
  historie_terminu                       historie_terminu[]
  predmet                                predmet            @relation(fields: [kod_predmet], references: [kod_predmetu], onDelete: Cascade)
  vyucujici_termin_vypsal_idTovyucujici  vyucujici          @relation("termin_vypsal_idTovyucujici", fields: [vypsal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vyucujici_termin_vyucuje_idTovyucujici vyucujici          @relation("termin_vyucuje_idTovyucujici", fields: [vyucuje_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model vyucujici {
  id                                  String               @id @db.Char(40)
  termin_termin_vypsal_idTovyucujici  termin[]             @relation("termin_vypsal_idTovyucujici")
  termin_termin_vyucuje_idTovyucujici termin[]             @relation("termin_vyucuje_idTovyucujici")
  vyucujici_predmety                  vyucujici_predmety[]
}

model vyucujici_predmety {
  vyucujici_id String    @db.VarChar(40)
  kod_predmetu String
  id           BigInt    @id @default(autoincrement())
  predmet      predmet   @relation(fields: [kod_predmetu], references: [kod_predmetu], onDelete: Cascade)
  vyucujici    vyucujici @relation(fields: [vyucujici_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
